# ===============================
# DATABASE
# ===============================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/knowledge-engine?retryWrites=true&w=majority

# ===============================
# REDIS (QUEUE SYSTEM)
# ===============================
REDIS_URL=redis://default:<password>@<host>:<port>

# ===============================
# AI PROVIDERS
# ===============================

# Primary (fast + free tier friendly)
GROQ_API_KEY=your_groq_api_key

# Optional (fallback / experimentation)
OPENAI_API_KEY=your_openai_api_key

# Optional (Gemini fallback)
GOOGLE_GENAI_API_KEY=your_google_api_key

# ===============================
# MODEL CONFIG (OPTIONAL OVERRIDE)
# ===============================
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=llama-3.3-70b-versatile

# ===============================
# FILE STORAGE (IMPORTANT FOR DEPLOY)
# ===============================

# If using AWS S3 (recommended for production)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_BUCKET_NAME=your_bucket_name
AWS_REGION=your_region

# ===============================
# SERVER
# ===============================
PORT=5000
NODE_ENV=production

# ===============================
# FRONTEND (for CORS control)
# ===============================
CLIENT_URL=http://localhost:5173
